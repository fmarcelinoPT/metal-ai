{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (metalai.onemarc.io)",
      "options": {
        "baseURL": "http://metalai.onemarc.io:11434/v1"
      },
      "models": {
        "dis-assistant-cos": {
          "name": "DiS CoS (40K) - Primary Orchestrator",
          "tools": true,
          "reasoning": true,
          "options": {
            "num_ctx": 40960
          }
        },
        "dis-assistant-magistral": {
          "name": "DiS Magistral (40K) - Reasoning & Analysis",
          "tools": false,
          "reasoning": true,
          "options": {
            "num_ctx": 40960
          }
        },
        "dis-assistant-granite": {
          "name": "DiS Granite (32K) - Executive Assistant",
          "tools": false,
          "reasoning": true,
          "options": {
            "num_ctx": 32768
          }
        },
        "dis-assistant-coder": {
          "name": "DiS Coder (32K) - Agentic Coding",
          "tools": true,
          "reasoning": true,
          "options": {
            "num_ctx": 32768
          }
        }
      }
    }
  },
  "default_agent": "cos",
  "agent": {
    "cos": {
      "description": "Primary orchestrator agent with tool calling capabilities for file manipulation and task delegation",
      "mode": "primary",
      "model": "ollama/dis-assistant-cos",
      "prompt": "{file:./agent/cos.md}",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "magistral": {
      "description": "Strategic analysis subagent for deep reasoning, brainstorming, and complex analysis tasks",
      "mode": "subagent",
      "model": "ollama/dis-assistant-magistral",
      "prompt": "{file:./agent/magistral.md}",
      "tools": {
        "read": false,
        "glob": false,
        "grep": false,
        "bash": false,
        "write": false,
        "edit": false
      }
    },
    "coder": {
      "description": "Agentic coding assistant for development tasks",
      "mode": "subagent",
      "model": "ollama/dis-assistant-coder",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "granite": {
      "description": "Quick assistant for document review and analysis",
      "mode": "subagent",
      "model": "ollama/dis-assistant-granite",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "bash": false,
        "write": false,
        "edit": false
      }
    }
  },
  "autoupdate": true
}
