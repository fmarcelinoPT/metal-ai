{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (metalai.onemarc.io)",
      "options": {
        "baseURL": "http://metalai.onemarc.io:11434/v1"
      },
      "models": {
        "dis-assistant-exec": {
          "name": "DiS Exec (40K) - Primary Orchestrator",
          "tools": true,
          "reasoning": true,
          "options": {
            "num_ctx": 40960
          }
        },
        "dis-assistant-analyst": {
          "name": "DiS Analyst (40K) - Strategic Analysis",
          "tools": false,
          "reasoning": true,
          "options": {
            "num_ctx": 40960
          }
        },
        "dis-assistant-coder": {
          "name": "DiS Coder (32K) - Agentic Coding",
          "tools": true,
          "reasoning": true,
          "options": {
            "num_ctx": 32768
          }
        }
      }
    }
  },
  "default_agent": "exec",
  "agent": {
    "exec": {
      "description": "Primary orchestrator agent with tool calling capabilities for file manipulation and task delegation",
      "mode": "primary",
      "model": "ollama/dis-assistant-exec",
      "prompt": "{file:./agent/exec.md}",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    },
    "analyst": {
      "description": "Strategic analysis subagent for deep reasoning, brainstorming, and complex analysis tasks",
      "mode": "subagent",
      "model": "ollama/dis-assistant-analyst",
      "prompt": "{file:./agent/analyst.md}",
      "tools": {
        "read": false,
        "glob": false,
        "grep": false,
        "bash": false,
        "write": false,
        "edit": false
      }
    },
    "coder": {
      "description": "Agentic coding assistant for development tasks",
      "mode": "subagent",
      "model": "ollama/dis-assistant-coder",
      "tools": {
        "read": true,
        "glob": true,
        "grep": true,
        "bash": true,
        "write": true,
        "edit": true
      }
    }
  },
  "autoupdate": true
}
