# Extended context for long documents and conversations
PARAMETER num_ctx 40960

# Multi-GPU optimization
PARAMETER num_gpu 99

# Batch processing optimized for RTX 3090
PARAMETER num_batch 512
PARAMETER num_thread 8

# Extended prediction for complete responses
PARAMETER num_predict 4096

# Increased repetition memory for executive context
PARAMETER repeat_last_n 256

